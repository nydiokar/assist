# Derivative artifacts and raw corpus — never in git (v1 §8).
local_data/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
# Eval outputs quote verbatim corpus text (answers/citations) — never in git. Cover .json AND
# .jsonl (the agent-eval writer emits agent_eval.jsonl).
eval/results/
# Real NGO files must never be committed; only synthetic fixtures under tests/fixtures/.
yspdb/
drive-download-*.zip
# Holdout final-report corpus for Task D report-section questions — real NGO content, no egress.
holdout-report/
# Report-section eval questions: their expect_substrings quote VERBATIM corpus text (org names,
# grant number, Bulgarian quotes). Real corpus must never enter git (AGENTS.md). Kept locally for
# the demo/eval; untracked. (The old yp_report_questions_candidate.jsonl was committed at 43873a1 —
# scrubbing that is a destructive history rewrite and needs owner sign-off.)
eval/yp_report_questions_candidate.jsonl
eval/yp_report_questions.jsonl
# Scratch authoring inputs (corpus-derived); regenerable, not committed.
scripts/_*.txt
scripts/_*.jsonl
# Live MCP registration: host-specific absolute paths + points at the gitignored corpus config.
# Committed template is .mcp.json.example — copy and edit per machine.
.mcp.json

*.egg-info/
